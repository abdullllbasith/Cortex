// ── Module 13: CRM ───────────────────────────────────────────────────────────

enum ContactType {
  CUSTOMER
  LEAD
  PROSPECT
}

enum ContactSource {
  MANUAL
  IMPORT
  WEBSITE
  REFERRAL
  WHATSAPP
  SOCIAL
}

enum DealStatus {
  OPEN
  WON
  LOST
  ON_HOLD
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  WHATSAPP
  DEMO
}

model CrmContact {
  id               String          @id @default(cuid())
  tenantId         String
  type             ContactType     @default(LEAD)
  firstName        String
  lastName         String
  email            String?
  phone            String?
  mobile           String?
  company          String?
  jobTitle         String?
  source           ContactSource   @default(MANUAL)
  ownerId          String?
  tags             String[]        @default([])
  notes            String?         @db.Text
  address          Json            @default("{}")
  customFields     Json            @default("{}")
  doNotContact     Boolean         @default(false)
  isActive         Boolean         @default(true)
  lastContactedAt  DateTime?
  nextFollowUpAt   DateTime?
  embedding        Unsupported("vector(1536)")?
  embeddingStatus  EmbeddingStatus @default(PENDING)
  embeddingContentHash String?
  embeddingUpdatedAt   DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner     User?            @relation("CrmContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  companies ContactCompany[]
  deals     CrmDeal[]
  activities CrmActivity[]
  quotes    Quote[]
  orders    SalesOrder[]
  invoices  Invoice[]
  payments  Payment[]

  @@index([tenantId, email])
  @@index([tenantId, ownerId])
  @@index([tenantId, type])
  @@index([tenantId, nextFollowUpAt])
  @@index([tenantId, embeddingStatus])
  @@map("crm_contacts")
}

model CrmCompany {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  industry       String?
  size           String?
  website        String?
  phone          String?
  address        Json     @default("{}")
  ownerId        String?
  tags           String[] @default([])
  annualRevenue  Decimal? @db.Decimal(16, 2)
  employeeCount  Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner      User?            @relation("CrmCompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   ContactCompany[]
  deals      CrmDeal[]
  activities CrmActivity[]
  quotes     Quote[]
  orders     SalesOrder[]
  invoices   Invoice[]

  @@index([tenantId, name])
  @@index([tenantId, ownerId])
  @@map("crm_companies")
}

model ContactCompany {
  id        String  @id @default(cuid())
  contactId String
  companyId String
  role      String?
  isPrimary Boolean @default(false)

  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company CrmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([contactId, companyId])
  @@map("crm_contact_companies")
}

model CrmPipeline {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  stages    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals  CrmDeal[]

  @@index([tenantId, isDefault])
  @@map("crm_pipelines")
}

model CrmDeal {
  id                String     @id @default(cuid())
  tenantId          String
  title             String
  contactId         String?
  companyId         String?
  ownerId           String?
  pipelineId        String
  stageId           String
  value             Decimal    @default(0) @db.Decimal(16, 2)
  currency          String     @default("USD")
  probability       Int        @default(0)
  expectedCloseDate DateTime?
  status            DealStatus @default(OPEN)
  lostReason        String?
  wonAt             DateTime?
  lostAt            DateTime?
  stageEnteredAt    DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company  CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner    User?       @relation("CrmDealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  pipeline CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  activities CrmActivity[]
  quotes     Quote[]

  @@index([tenantId, pipelineId, stageId])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@map("crm_deals")
}

model CrmActivity {
  id          String       @id @default(cuid())
  tenantId    String
  type        ActivityType
  contactId   String?
  dealId      String?
  companyId   String?
  subject     String
  description String?      @db.Text
  outcome     String?
  scheduledAt DateTime?
  completedAt DateTime?
  duration    Int?
  createdBy   String?
  assignedTo  String?
  isCompleted Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact   CrmContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal      CrmDeal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator   User?       @relation("CrmActivityCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  assignee  User?       @relation("CrmActivityAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([tenantId, contactId])
  @@index([tenantId, dealId])
  @@index([tenantId, scheduledAt])
  @@map("crm_activities")
}

// ── Module 14: Sales Orders ──────────────────────────────────────────────────

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum FulfillmentStatus {
  PENDING
  PICKING
  PACKED
  SHIPPED
  DELIVERED
}

model Quote {
  id                 String      @id @default(cuid())
  tenantId           String
  quoteNumber        String
  contactId          String?
  companyId          String?
  dealId             String?
  ownerId            String?
  status             QuoteStatus @default(DRAFT)
  validUntil         DateTime?
  items              Json        @default("[]")
  subtotal           Decimal     @default(0) @db.Decimal(16, 2)
  discountTotal      Decimal     @default(0) @db.Decimal(16, 2)
  taxTotal           Decimal     @default(0) @db.Decimal(16, 2)
  total              Decimal     @default(0) @db.Decimal(16, 2)
  currency           String      @default("USD")
  notes              String?     @db.Text
  termsAndConditions String?     @db.Text
  sentAt             DateTime?
  viewedAt           DateTime?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal    CrmDeal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  owner   User?       @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  orders  SalesOrder[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId, status])
  @@index([tenantId, contactId])
  @@map("quotes")
}

model SalesOrder {
  id              String           @id @default(cuid())
  tenantId        String
  orderNumber     String
  quoteId         String?
  contactId       String?
  companyId       String?
  ownerId         String?
  status          SalesOrderStatus @default(DRAFT)
  items           Json             @default("[]")
  subtotal        Decimal          @default(0) @db.Decimal(16, 2)
  discountTotal   Decimal          @default(0) @db.Decimal(16, 2)
  taxTotal        Decimal          @default(0) @db.Decimal(16, 2)
  shippingCost    Decimal          @default(0) @db.Decimal(16, 2)
  total           Decimal          @default(0) @db.Decimal(16, 2)
  currency        String           @default("USD")
  shippingAddress Json             @default("{}")
  billingAddress  Json             @default("{}")
  paymentStatus   PaymentStatus    @default(UNPAID)
  notes           String?          @db.Text
  confirmedAt     DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote        Quote?             @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  contact      CrmContact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      CrmCompany?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner        User?              @relation("SalesOrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  fulfillments OrderFulfillment[]
  invoices     Invoice[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, contactId])
  @@map("sales_orders")
}

model OrderFulfillment {
  id             String            @id @default(cuid())
  orderId        String
  tenantId       String
  status         FulfillmentStatus @default(PENDING)
  warehouseId    String?
  items          Json              @default("[]")
  trackingNumber String?
  carrier        String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([tenantId, orderId])
  @@map("order_fulfillments")
}

// ── Module 15: Finance ───────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalReferenceType {
  INVOICE
  BILL
  PAYMENT
  PAYROLL
  ADJUSTMENT
  OPENING
  TRANSFER
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOIDED
}

enum TaxRateType {
  SALES
  PURCHASE
  BOTH
}

model Account {
  id          String      @id @default(cuid())
  tenantId    String
  code        String      @db.VarChar(10)
  name        String
  type        AccountType
  subtype     String?
  parentId    String?
  isSystem    Boolean     @default(false)
  isActive    Boolean     @default(true)
  description String?     @db.Text
  currency    String      @default("USD")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       Account?      @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Account[]     @relation("AccountTree")
  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@index([tenantId, parentId])
  @@map("finance_accounts")
}

model JournalEntry {
  id            String               @id @default(cuid())
  tenantId      String
  entryNumber   String               @db.VarChar(20)
  date          DateTime             @db.Date
  description   String
  reference     String?
  referenceType JournalReferenceType @default(ADJUSTMENT)
  referenceId   String?
  status        JournalEntryStatus   @default(DRAFT)
  postedBy      String?
  postedAt      DateTime?
  voidReason    String?
  voidedBy      String?
  voidedAt      DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  postedByUser   User?         @relation("JournalEntryPoster", fields: [postedBy], references: [id], onDelete: SetNull)
  voidedByUser   User?         @relation("JournalEntryVoider", fields: [voidedBy], references: [id], onDelete: SetNull)
  lines          JournalLine[]
  payments       Payment[]
  billPayments   BillPayment[]
  payrollRuns    PayrollRun[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, status])
  @@index([tenantId, date])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Decimal @default(0) @db.Decimal(15, 2)
  credit         Decimal @default(0) @db.Decimal(15, 2)
  currency       String  @default("USD")
  exchangeRate   Decimal @default(1) @db.Decimal(12, 6)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model TaxRate {
  id        String      @id @default(cuid())
  tenantId  String
  name      String
  rate      Decimal     @db.Decimal(5, 2)
  type      TaxRateType @default(BOTH)
  isDefault Boolean     @default(false)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("tax_rates")
}

model FiscalPeriod {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  isClosed  Boolean   @default(false)
  closedBy  String?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startDate])
  @@map("fiscal_periods")
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIAL
  PAID
  OVERDUE
  VOID
  CANCELLED
}

enum FinancePaymentType {
  INVOICE_PAYMENT
  ADVANCE
  REFUND
}

enum FinancePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  CREDIT
}

model Invoice {
  id                 String        @id @default(cuid())
  tenantId           String
  invoiceNumber      String
  contactId          String?
  companyId          String?
  orderId            String?
  status             InvoiceStatus @default(DRAFT)
  issueDate          DateTime
  dueDate            DateTime
  items              Json          @default("[]")
  subtotal           Decimal       @default(0) @db.Decimal(16, 2)
  discountTotal      Decimal       @default(0) @db.Decimal(16, 2)
  taxTotal           Decimal       @default(0) @db.Decimal(16, 2)
  total              Decimal       @default(0) @db.Decimal(16, 2)
  amountPaid         Decimal       @default(0) @db.Decimal(16, 2)
  amountDue          Decimal       @default(0) @db.Decimal(16, 2)
  currency           String        @default("USD")
  notes              String?       @db.Text
  termsAndConditions String?       @db.Text
  paidAt             DateTime?
  sentAt             DateTime?
  viewedAt           DateTime?
  createdBy          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact   CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
