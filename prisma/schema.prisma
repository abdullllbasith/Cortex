// SAIOS Module 01 — Enterprise Knowledge Engine
// PostgreSQL + pgvector for semantic search

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum TenantPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum BusinessKnowledgeType {
  POLICY
  SOP
  DOCUMENT
  CONTRACT
  REPORT
}

enum EmbeddingStatus {
  PENDING
  INDEXED
  ERROR
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ConversationIntent {
  QUERY
  COMMAND
  REPORT
  FORECAST
  AUTOMATION
}

enum AgentType {
  FINANCE
  SALES
  INVENTORY
  OPERATIONS
  EXECUTIVE
}

enum AgentTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum AgentTaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum AgentLogStatus {
  SUCCESS
  FAILURE
  PARTIAL
}

enum InventoryEventType {
  RESTOCK
  SALE
  ADJUSTMENT
  WASTE
}

enum ProductUnit {
  PCS
  KG
  L
  M
  BOX
  PACK
}

enum StockTransactionType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_IN
  RETURN_OUT
  DAMAGE
  WRITE_OFF
  OPENING
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum InventoryCostingMethod {
  FIFO
  WEIGHTED_AVERAGE
  LIFO
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  COMPLETE
}

enum CustomerEventType {
  VISIT
  PURCHASE
  CHURN
  RETURN
  COMPLAINT
}

enum SupplierEventType {
  ORDER
  DELIVERY
  DELAY
  RETURN
}

enum SupplierType {
  MANUFACTURER
  DISTRIBUTOR
  WHOLESALER
  SERVICE_PROVIDER
}

enum PaymentTerms {
  IMMEDIATE
  NET15
  NET30
  NET45
  NET60
}

enum AnalyticsSnapshotType {
  SALES_HOURLY
  SALES_DAILY
  SALES_WEEKLY
  CUSTOMER_DAILY
  INVENTORY_HOURLY
  SUPPLIER_DAILY
  EXECUTIVE_DAILY
}

enum FeatureEntityType {
  SALES
  CUSTOMER
  INVENTORY
  SUPPLIER
}

enum MLModelType {
  SALES_FORECAST
  INVENTORY_FORECAST
  CUSTOMER_CHURN
  SUPPLIER_RISK
}

enum MLModelStatus {
  ACTIVE
  TRAINING
  DEPRECATED
}

enum MLPredictionType {
  SALES_FORECAST
  INVENTORY_STOCKOUT
  CUSTOMER_CHURN
  SUPPLIER_RISK
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AlertType {
  STOCKOUT
  REVENUE_DROP
  CUSTOMER_CHURN
  SUPPLIER_DELAY
  GENERAL
}

enum WorkflowTriggerType {
  MANUAL
  EVENT
  SCHEDULE
  WEBHOOK
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum WorkflowNodeExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

enum UserRole {
  OWNER
  CEO
  MANAGER
  FINANCE_OFFICER
  SALES_OFFICER
  EMPLOYEE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
  BILLING_ADMIN
}

enum AnnouncementType {
  MAINTENANCE
  FEATURE
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FeatureFlagScope {
  ALL
  NONE
  SPECIFIC_TENANTS
  SPECIFIC_PLANS
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  MFA_ENABLED
  MFA_DISABLED
  PASSWORD_CHANGED
  PERMISSION_DENIED
  SUSPICIOUS_ACTIVITY
  DATA_EXPORT
  BULK_DELETE
}

enum NotificationType {
  ALERT
  SYSTEM
  ACTIVITY
  MENTION
  REMINDER
  BILLING
  SECURITY
}

enum NotificationSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum NotificationDigestFrequency {
  IMMEDIATE
  HOURLY
  DAILY
  WEEKLY
}

// ── Tenant (multi-tenant root) ───────────────────────────────────────────────

model Tenant {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  plan      TenantPlan @default(STARTER)
  settings  Json       @default("{}")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  customers            Customer[]
  products             Product[]
  suppliers            Supplier[]
  supplierContacts     SupplierContact[]
  supplierProducts     SupplierProduct[]
  reorderSnoozes       ReorderSnooze[]
  businessKnowledge    BusinessKnowledge[]
  conversationSessions ConversationSession[]
  channelConnections   ChannelConnection[]
  agentMemories        AgentMemory[]
  agentLogs            AgentLog[]
  agentTasks           AgentTask[]
  salesEvents          SalesEvent[]
  inventoryEvents      InventoryEvent[]
  customerEvents       CustomerEvent[]
  supplierEvents       SupplierEvent[]
  analyticsSnapshots   AnalyticsSnapshot[]
  featureSnapshots     FeatureSnapshot[]
  mlModels             MLModel[]
  mlPredictions        MLPrediction[]
  alerts               Alert[]
  alertRules           AlertRule[]
  workflowDefinitions  WorkflowDefinition[]
  workflowExecutions   WorkflowExecution[]
  users                User[]
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  securityEvents       SecurityEvent[]
  customRoles          CustomRole[]
  roleChanges          RoleChange[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  notificationDigests  NotificationDigest[]
  pushSubscriptions    PushSubscription[]
  webhookEndpoints   WebhookEndpoint[]
  teamInvitations    TeamInvitation[]
  supportTickets     SupportTicket[]
  categories         Category[]
  productVariants    ProductVariant[]
  warehouses         Warehouse[]
  stockLedger        StockLedger[]
  stockBalances      StockBalance[]
  stockTransfers     StockTransfer[]
  stockReservations  StockReservation[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  poApprovalRules    POApprovalRule[]
  crmContacts        CrmContact[]
  crmCompanies       CrmCompany[]
  crmDeals           CrmDeal[]
  crmPipelines       CrmPipeline[]
  crmActivities      CrmActivity[]
  quotes             Quote[]
  salesOrders        SalesOrder[]
  orderFulfillments  OrderFulfillment[]
  financeAccounts    Account[]
  journalEntries     JournalEntry[]
  taxRates           TaxRate[]
  fiscalPeriods      FiscalPeriod[]
  invoices           Invoice[]
  financePayments    Payment[]
  bills              Bill[]
  billPayments       BillPayment[]
  departments        Department[]
  designations       Designation[]
  employees          Employee[]
  leaveTypes         LeaveType[]
  leaveAllocations   LeaveAllocation[]
  leaveRequests    LeaveRequest[]
  attendances        Attendance[]
  salaryStructures   SalaryStructure[]
  employeeSalaries   EmployeeSalary[]
  payrollRuns        PayrollRun[]
  payrollSlips       PayrollSlip[]

  @@map("tenants")
}

// ── Customer ─────────────────────────────────────────────────────────────────

model Customer {
  id                   String          @id @default(cuid())
  tenantId             String
  profile              Json            @default("{}")
  purchaseHistory      Json            @default("[]")
  preferences          Json            @default("{}")
  communicationHistory Json            @default("[]")
  loyaltyData          Json            @default("{}")
  embedding            Unsupported("vector(1536)")?
  embeddingStatus      EmbeddingStatus @default(PENDING)
  embeddingContentHash String?
  embeddingUpdatedAt   DateTime?
  version              Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, embeddingStatus])
  @@index([tenantId, updatedAt])
  @@map("customers")
}

// ── Product (Module 12 — Inventory Operations) ───────────────────────────────

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  parentId    String?
  sortOrder   Int      @default(0)
  description String?  @db.Text
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Product {
  id                   String          @id @default(cuid())
  tenantId             String
  sku                  String
  barcode              String?
  name                 String
  slug                 String
  description          String?         @db.Text
  categoryId           String?
  unit                 ProductUnit     @default(PCS)
  costPrice            Decimal         @default(0) @db.Decimal(14, 4)
  sellingPrice         Decimal         @default(0) @db.Decimal(14, 4)
  minSellingPrice      Decimal?        @db.Decimal(14, 4)
  taxRate              Decimal         @default(0) @db.Decimal(5, 2)
  imageUrls            String[]        @default([])
  isActive             Boolean         @default(true)
  isService            Boolean         @default(false)
  trackInventory       Boolean         @default(true)
  reorderPoint         Decimal         @default(0) @db.Decimal(14, 4)
  reorderQuantity      Decimal         @default(0) @db.Decimal(14, 4)
  leadTimeDays         Int             @default(7)
  supplierId           String?
  weight               Decimal?        @db.Decimal(10, 3)
  dimensions           Json            @default("{}")
  // Legacy knowledge-engine fields (backward compatible)
  catalog              Json            @default("{}")
  inventoryLevel       Int             @default(0)
  supplierInfo         Json            @default("{}")
  pricingHistory       Json            @default("[]")
  embedding            Unsupported("vector(1536)")?
  embeddingStatus      EmbeddingStatus @default(PENDING)
  embeddingContentHash String?
  embeddingUpdatedAt   DateTime?
  version              Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier      Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierLinks SupplierProduct[]
  variants      ProductVariant[]
  stockLedger   StockLedger[]
  stockBalances StockBalance[]
  reservations  StockReservation[]

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, barcode])
  @@index([tenantId, categoryId])
  @@index([tenantId, isActive])
  @@index([tenantId, embeddingStatus])
  @@map("products")
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  tenantId     String
  name         String
  sku          String
  barcode      String?
  attributes   Json     @default("{}")
  costPrice    Decimal? @db.Decimal(14, 4)
  sellingPrice Decimal? @db.Decimal(14, 4)
  imageUrl     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLedger   StockLedger[]
  stockBalances StockBalance[]
  reservations  StockReservation[]

  @@unique([tenantId, sku])
  @@index([productId])
  @@index([tenantId, barcode])
  @@map("product_variants")
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   Json     @default("{}")
  isDefault Boolean  @default(false)
  managerId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager          User?           @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  locations        StockLocation[]
  stockLedger      StockLedger[]
  stockBalances    StockBalance[]
  reservations     StockReservation[]
  transfersFrom    StockTransfer[] @relation("TransferFrom")
  transfersTo      StockTransfer[] @relation("TransferTo")
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  orderFulfillments OrderFulfillment[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("warehouses")
}

model StockLocation {
  id          String   @id @default(cuid())
  warehouseId String
  name        String
  aisle       String?
  shelf       String?
  bin         String?
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@map("stock_locations")
}

model StockLedger {
  id              String               @id @default(cuid())
  tenantId        String
  productId       String
  variantId       String?
  warehouseId     String
  transactionType StockTransactionType
  quantity        Decimal              @db.Decimal(14, 4)
  unitCost        Decimal              @default(0) @db.Decimal(14, 4)
  totalCost       Decimal              @default(0) @db.Decimal(14, 4)
  referenceType   String?
  referenceId     String?
  notes           String?              @db.Text
  performedBy     String?
  createdAt       DateTime             @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  performer User?           @relation("StockLedgerPerformer", fields: [performedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, warehouseId, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@map("stock_ledger")
}

model StockBalance {
  id               String   @id @default(cuid())
  tenantId         String
  productId        String
  variantId        String?
  warehouseId      String
  quantityOnHand   Decimal  @default(0) @db.Decimal(14, 4)
  quantityReserved Decimal  @default(0) @db.Decimal(14, 4)
  quantityOnOrder  Decimal  @default(0) @db.Decimal(14, 4)
  lastUpdatedAt    DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, variantId, warehouseId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, productId])
  @@map("stock_balances")
}

model StockReservation {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  variantId   String?
  warehouseId String
  referenceId String
  quantity    Decimal  @db.Decimal(14, 4)
  createdAt   DateTime @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId, referenceId])
  @@index([tenantId, productId, warehouseId])
  @@map("stock_reservations")
}

model StockTransfer {
  id              String              @id @default(cuid())
  tenantId        String
  fromWarehouseId String
  toWarehouseId   String
  status          StockTransferStatus @default(DRAFT)
  items           Json                @default("[]")
  initiatedBy     String?
  completedBy     String?
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  completedAt     DateTime?

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  initiator     User?     @relation("TransferInitiator", fields: [initiatedBy], references: [id], onDelete: SetNull)
  completer     User?     @relation("TransferCompleter", fields: [completedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("stock_transfers")
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  tenantId         String
  poNumber         String
  supplierId       String
  warehouseId      String
  status           PurchaseOrderStatus @default(DRAFT)
  items            Json                @default("[]")
  subtotal         Decimal             @default(0) @db.Decimal(14, 4)
  taxTotal         Decimal             @default(0) @db.Decimal(14, 4)
  shippingCost     Decimal             @default(0) @db.Decimal(14, 4)
  grandTotal       Decimal             @default(0) @db.Decimal(14, 4)
  currency         String              @default("USD")
  expectedDelivery DateTime?
  terms            String?             @db.Text
  notes            String?             @db.Text
  approvedBy       String?
  approvedAt       DateTime?
  sentAt           DateTime?
  createdBy        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  approver    User?         @relation("POApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  creator     User?         @relation("POCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  receipts    GoodsReceipt[]
  bills       Bill[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, expectedDelivery])
  @@index([tenantId, createdAt])
  @@map("purchase_orders")
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  receiptNumber   String
  warehouseId     String
  status          GoodsReceiptStatus @default(DRAFT)
  items           Json               @default("[]")
  receivedBy      String?
  receivedAt      DateTime?
  notes           String?            @db.Text
  createdAt       DateTime           @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receiver      User?         @relation("GoodsReceiver", fields: [receivedBy], references: [id], onDelete: SetNull)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, receivedAt])
  @@map("goods_receipts")
}

model POApprovalRule {
  id                   String   @id @default(cuid())
  tenantId             String
  minAmount            Decimal  @db.Decimal(14, 4)
  maxAmount            Decimal? @db.Decimal(14, 4)
  requiredApproverRole UserRole
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("po_approval_rules")
}

// ── Supplier ─────────────────────────────────────────────────────────────────

model Supplier {
  id                   String          @id @default(cuid())
  tenantId             String
  code                 String          @default("")
  name                 String
  type                 SupplierType    @default(DISTRIBUTOR)
  contactName          String?
  email                String?
  phone                String?
  mobile               String?
  website              String?
  address              Json            @default("{}")
  paymentTerms         PaymentTerms    @default(NET30)
  currency             String          @default("USD")
  taxNumber            String?
  bankDetailsEnc       String?         @db.Text
  creditLimit          Decimal?        @db.Decimal(14, 2)
  isActive             Boolean         @default(true)
  notes                String?         @db.Text
  rating               Decimal?        @db.Decimal(3, 2)
  performanceScore     Float           @default(0)
  deliveryHistory      Json            @default("[]")
  reliabilityMetrics   Json            @default("{}")
  costTrends           Json            @default("[]")
  embedding            Unsupported("vector(1536)")?
  embeddingStatus      EmbeddingStatus @default(PENDING)
  embeddingContentHash String?
  embeddingUpdatedAt   DateTime?
  version              Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products         Product[]
  purchaseOrders   PurchaseOrder[]
  contacts         SupplierContact[]
  supplierProducts SupplierProduct[]
  bills            Bill[]
  billPayments     BillPayment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, isActive])
  @@index([tenantId, type])
  @@index([tenantId, embeddingStatus])
  @@map("suppliers")
}

model SupplierContact {
  id          String   @id @default(cuid())
  tenantId    String
  supplierId  String
  name        String
  email       String?
  phone       String?
  designation String?
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId, supplierId])
  @@index([tenantId, supplierId, isPrimary])
  @@map("supplier_contacts")
}

model SupplierProduct {
  id            String    @id @default(cuid())
  tenantId      String
  supplierId    String
  productId     String
  supplierSku   String?
  unitCost      Decimal   @default(0) @db.Decimal(14, 4)
  minOrderQty   Int       @default(1)
  leadTimeDays  Int       @default(7)
  isPreferred   Boolean   @default(false)
  lastPriceDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, supplierId, productId])
  @@index([tenantId, supplierId])
  @@index([tenantId, productId])
  @@map("supplier_products")
}

model ReorderSnooze {
  id           String   @id @default(cuid())
  tenantId     String
  productId    String
  snoozedUntil DateTime
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId])
  @@index([tenantId, snoozedUntil])
  @@map("reorder_snoozes")
}

// ── BusinessKnowledge ────────────────────────────────────────────────────────

model BusinessKnowledge {
  id                   String                @id @default(cuid())
  tenantId             String
  type                 BusinessKnowledgeType
  title                String
  content              String                @db.Text
