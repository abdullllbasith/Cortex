enum DesignationLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  C_LEVEL
}

enum EmployeeType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  PROBATION
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  HOLIDAY
  WEEKEND
}

enum AttendanceSource {
  MANUAL
  MOBILE
  WEB
}

model Department {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  code       String
  managerId  String?
  parentId   String?
  headcount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager     Employee?    @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentHierarchy")
  designations Designation[]
  employees   Employee[]   @relation("EmployeeDepartment")

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("departments")
}

model Designation {
  id           String           @id @default(cuid())
  tenantId     String
  title        String
  departmentId String?
  level        DesignationLevel @default(MID)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees  Employee[]

  @@unique([tenantId, title])
  @@index([tenantId, departmentId])
  @@map("designations")
}

model Employee {
  id                 String         @id @default(cuid())
  tenantId           String
  userId             String?        @unique
  employeeNumber     String
  firstName          String
  lastName           String
  email              String
  phone              String?
  dateOfBirth        DateTime?
  gender             String?
  nationalId         String?
  address            Json           @default("{}")
  photo              String?
  departmentId       String?
  designationId      String?
  managerId          String?
  type               EmployeeType   @default(FULL_TIME)
  status             EmployeeStatus @default(ACTIVE)
  joinDate           DateTime
  confirmationDate   DateTime?
  terminationDate    DateTime?
  terminationReason  String?        @db.Text
  emergencyContact   Json           @default("{}")
  bankDetailsEnc     String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  department       Department?       @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  designation      Designation?      @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manager          Employee?         @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports    Employee[]        @relation("EmployeeManager")
  departmentsManaged Department[]    @relation("DepartmentManager")
  leaveAllocations LeaveAllocation[]
  leaveRequests    LeaveRequest[]
  attendances      Attendance[]
  leaveApprovals   LeaveRequest[]    @relation("LeaveApprover")
  employeeSalaries EmployeeSalary[]
  payrollSlips     PayrollSlip[]

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, designationId])
  @@map("employees")
}

model LeaveType {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  code             String
  daysAllowed      Decimal  @default(0) @db.Decimal(5, 1)
  carryForward     Boolean  @default(false)
  maxCarryForward  Decimal  @default(0) @db.Decimal(5, 1)
  isPaid           Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocations LeaveAllocation[]
  requests    LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("leave_types")
}

model LeaveAllocation {
  id            String   @id @default(cuid())
  tenantId      String
  employeeId    String
  leaveTypeId   String
  fiscalYear    Int
  allocatedDays Decimal  @default(0) @db.Decimal(5, 1)
  usedDays      Decimal  @default(0) @db.Decimal(5, 1)
  remainingDays Decimal  @default(0) @db.Decimal(5, 1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, leaveTypeId, fiscalYear])
  @@index([tenantId, employeeId])
  @@map("leave_allocations")
}

model LeaveRequest {
  id             String             @id @default(cuid())
  tenantId       String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  days           Decimal            @db.Decimal(5, 1)
  reason         String?            @db.Text
  status         LeaveRequestStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approver  Employee?  @relation("LeaveApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@index([tenantId, startDate, endDate])
  @@map("leave_requests")
}

model Attendance {
  id            String           @id @default(cuid())
  tenantId      String
  employeeId    String
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  workingHours  Decimal          @default(0) @db.Decimal(5, 2)
  status        AttendanceStatus @default(PRESENT)
  source        AttendanceSource @default(WEB)
  notes         String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@index([tenantId, employeeId, date])
  @@map("attendances")
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
  BENEFIT
}

enum SalaryCalculationType {
  FIXED
  PERCENTAGE_OF_BASIC
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  REVIEW
  APPROVED
  PAID
  CANCELLED
}

enum PayrollSlipStatus {
  DRAFT
  FINAL
}

model SalaryStructure {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  components Json     @default("[]")
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeSalaries EmployeeSalary[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("salary_structures")
}

model EmployeeSalary {
  id                String   @id @default(cuid())
  tenantId          String
  employeeId        String
  salaryStructureId String
  basicSalary       Decimal  @db.Decimal(12, 2)
  effectiveFrom     DateTime @db.Date
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)
  creator         User?           @relation("EmployeeSalaryCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId])
  @@index([tenantId, effectiveFrom])
  @@map("employee_salaries")
}

model PayrollRun {
  id              String           @id @default(cuid())
  tenantId        String
  month           Int
  year            Int
  status          PayrollRunStatus @default(DRAFT)
  totalGross      Decimal          @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal          @default(0) @db.Decimal(14, 2)
  totalNet        Decimal          @default(0) @db.Decimal(14, 2)
  employeeCount   Int              @default(0)
  processedBy     String?
  approvedBy      String?
  paidAt          DateTime?
  journalEntryId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slips         PayrollSlip[]
  processor     User?         @relation("PayrollProcessor", fields: [processedBy], references: [id], onDelete: SetNull)
  approver      User?         @relation("PayrollApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  journalEntry  JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([tenantId, month, year])
  @@index([tenantId, status])
  @@map("payroll_runs")
}

model PayrollSlip {
  id              String            @id @default(cuid())
  payrollRunId    String
  tenantId        String
  employeeId      String
  earnings        Json              @default("[]")
  deductions      Json              @default("[]")
  grossSalary     Decimal           @db.Decimal(12, 2)
  totalDeductions Decimal           @db.Decimal(12, 2)
  netSalary       Decimal           @db.Decimal(12, 2)
  workingDays     Int               @default(0)
  presentDays     Decimal           @default(0) @db.Decimal(5, 1)
  leaveDeductions Decimal           @default(0) @db.Decimal(12, 2)
  taxDeducted     Decimal           @default(0) @db.Decimal(12, 2)
  status          PayrollSlipStatus @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([tenantId, employeeId])
  @@map("payroll_slips")
}

