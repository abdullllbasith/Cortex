}

model Payment {
  id              String               @id @default(cuid())
  tenantId        String
  type            FinancePaymentType   @default(INVOICE_PAYMENT)
  invoiceId       String?
  contactId       String?
  amount          Decimal              @db.Decimal(16, 2)
  currency        String               @default("USD")
  paymentMethod   FinancePaymentMethod @default(BANK_TRANSFER)
  paymentDate     DateTime
  reference       String?
  notes           String?              @db.Text
  journalEntryId  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  contact      CrmContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
  @@index([tenantId, paymentDate])
  @@map("finance_payments")
}

enum BillStatus {
  DRAFT
  PENDING
  PARTIAL
  PAID
  OVERDUE
  VOID
}

model Bill {
  id               String     @id @default(cuid())
  tenantId         String
  billNumber       String
  supplierId       String
  purchaseOrderId  String?
  status           BillStatus @default(DRAFT)
  issueDate        DateTime
  dueDate          DateTime
  items            Json       @default("[]")
  subtotal         Decimal    @default(0) @db.Decimal(16, 2)
