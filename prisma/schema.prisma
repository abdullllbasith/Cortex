model User {
  id                String    @id @default(cuid())
  tenantId          String
  supabaseId        String    @unique
  email             String    @unique
  fullName          String
  jobTitle          String?
  phone             String?
  avatarUrl         String?
  timezone          String?
  profileSettings   Json      @default("{}")
  role              UserRole  @default(EMPLOYEE)
  customPermissions Json      @default("[]")
  customRoleId      String?
  mfaEnabled        Boolean   @default(false)
  mfaSecretEnc      String?
  lastLoginAt       DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customRole   CustomRole?   @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  sessions     UserSession[]
  apiKeys      ApiKey[]
  auditLogs    AuditLog[]
  roleChanges  RoleChange[]  @relation("RoleChangeUser")
  roleChangesBy RoleChange[] @relation("RoleChangeBy")
  notifications Notification[]
  notificationPrefs NotificationPreference[]
  notificationDigests NotificationDigest[]
  pushSubscriptions PushSubscription[]
  invitationsSent TeamInvitation[] @relation("InvitationsSent")
  managedWarehouses Warehouse[] @relation("WarehouseManager")
  stockLedgerEntries StockLedger[] @relation("StockLedgerPerformer")
  transfersInitiated StockTransfer[] @relation("TransferInitiator")
  transfersCompleted StockTransfer[] @relation("TransferCompleter")
  purchaseOrdersCreated PurchaseOrder[] @relation("POCreator")
  purchaseOrdersApproved PurchaseOrder[] @relation("POApprover")
  goodsReceiptsReceived GoodsReceipt[] @relation("GoodsReceiver")
  crmContactsOwned      CrmContact[]   @relation("CrmContactOwner")
  crmCompaniesOwned     CrmCompany[]   @relation("CrmCompanyOwner")
  crmDealsOwned         CrmDeal[]      @relation("CrmDealOwner")
  crmActivitiesCreated  CrmActivity[]  @relation("CrmActivityCreator")
  crmActivitiesAssigned CrmActivity[]  @relation("CrmActivityAssignee")
  quotesOwned           Quote[]        @relation("QuoteOwner")
  salesOrdersOwned      SalesOrder[]   @relation("SalesOrderOwner")
  journalEntriesPosted  JournalEntry[] @relation("JournalEntryPoster")
  journalEntriesVoided  JournalEntry[] @relation("JournalEntryVoider")
  invoicesCreated       Invoice[]      @relation("InvoiceCreator")
  billsCreated          Bill[]         @relation("BillCreator")
  employeeProfile       Employee?
  employeeSalariesCreated EmployeeSalary[] @relation("EmployeeSalaryCreator")
  payrollRunsProcessed  PayrollRun[]   @relation("PayrollProcessor")
  payrollRunsApproved   PayrollRun[]   @relation("PayrollApprover")

  @@index([tenantId, role])
  @@index([tenantId, isActive])
  @@map("users")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([tenantId])
  @@map("user_sessions")
}

model ApiKey {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  name          String
  keyHash       String    @unique
  lastFourChars String
  permissions   Json      @default("[]")
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("api_keys")
}

model AuditLog {
  id            String        @id @default(cuid())
  tenantId      String
  userId        String?
  sessionId     String?
  action        String
  resourceType  String
  resourceId    String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime      @default(now())
  severity      AuditSeverity @default(INFO)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, timestamp])
  @@index([tenantId, userId])
  @@index([tenantId, resourceType, resourceId])
  @@map("audit_logs")
}

model SecurityEvent {
  id         String            @id @default(cuid())
  tenantId   String
  userId     String?
  eventType  SecurityEventType
  metadata   Json              @default("{}")
  ipAddress  String?
  timestamp  DateTime          @default(now())
  isResolved Boolean           @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType, timestamp])
  @@index([tenantId, isResolved])
  @@map("security_events")
}

model CustomRole {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@map("custom_roles")
}

model TeamInvitation {
  id           String           @id @default(cuid())
  tenantId     String
  email        String
  role         UserRole         @default(EMPLOYEE)
  customRoleId String?
  message      String?
  token        String           @unique @default(cuid())
  invitedById  String
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([token])
  @@unique([tenantId, email])
  @@map("team_invitations")
}

model RoleChange {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  changedById  String
  previousRole UserRole
  newRole      UserRole
  createdAt    DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation("RoleChangeUser", fields: [userId], references: [id], onDelete: Cascade)
  changedBy User   @relation("RoleChangeBy", fields: [changedById], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("role_changes")
}

// ── Module 09: Alerts & Notification Center ───────────────────────────────────

model Notification {
  id          String               @id @default(cuid())
  tenantId    String
  userId      String
  type        NotificationType
  title       String
  body        String               @db.Text
  severity    NotificationSeverity @default(INFO)
  isRead      Boolean              @default(false)
  readAt      DateTime?
  actionUrl   String?
  actionLabel String?
  metadata    Json                 @default("{}")
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead, createdAt])
  @@index([tenantId, userId, type, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id               String                      @id @default(cuid())
  tenantId         String
  userId           String
  notificationType NotificationType
  inApp            Boolean                     @default(true)
  email            Boolean                     @default(true)
  whatsapp         Boolean                     @default(false)
  slack            Boolean                     @default(false)
  sms              Boolean                     @default(false)
  quietHoursStart  String?
  quietHoursEnd    String?
  digest           NotificationDigestFrequency @default(IMMEDIATE)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, notificationType])
  @@map("notification_preferences")
}

model NotificationDigest {
  id            String                      @id @default(cuid())
  tenantId      String
  userId        String
  digestType    NotificationDigestFrequency
  notifications Json                        @default("[]")
  sentAt        DateTime?
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime                    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, digestType, periodEnd])
  @@map("notification_digests")
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

// ── Module 10: Settings Hub ───────────────────────────────────────────────────

model WebhookEndpoint {
  id             String    @id @default(cuid())
  tenantId       String
  url            String
  secret         String
  events         Json      @default("[]")
  isActive       Boolean   @default(true)
  lastDeliveryAt DateTime?
  successRate    Float     @default(100)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId, isActive])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  webhookId      String
  tenantId       String
  eventType      String
  statusCode     Int?
  responseTimeMs Int?
  success        Boolean  @default(false)
  payload        Json     @default("{}")
  responseBody   String?  @db.Text
  createdAt      DateTime @default(now())

  webhook WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([tenantId, createdAt])
  @@map("webhook_deliveries")
}

// ── Module 11: Platform Admin Panel ───────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  supabaseId   String    @unique
  email        String    @unique
  fullName     String
  role         AdminRole @default(SUPPORT)
  permissions  Json      @default("[]")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs              AdminAuditLog[]
  announcementsCreated   PlatformAnnouncement[]
  ticketsAssigned        SupportTicket[]        @relation("AssignedTickets")
  featureFlagsUpdated    FeatureFlag[]

  @@map("admin_users")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String?
  targetId    String?
  details     Json     @default("{}")
  ipAddress   String?
  timestamp   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, timestamp])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model PlatformAnnouncement {
  id          String           @id @default(cuid())
  title       String
  body        String           @db.Text
  type        AnnouncementType @default(FEATURE)
  targetPlans TenantPlan[]     @default([])
  scheduledAt DateTime?
  expiresAt   DateTime?
  isActive    Boolean          @default(true)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy AdminUser @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isActive, scheduledAt])
  @@map("platform_announcements")
}

model SupportTicket {
  id           String                @id @default(cuid())
  tenantId     String
  userId       String?
  subject      String
  description  String                @db.Text
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(MEDIUM)
  assignedToId String?
  resolution   String?               @db.Text
  createdAt    DateTime              @default(now())
  resolvedAt   DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo AdminUser? @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([assignedToId, status])
  @@map("support_tickets")
}

model FeatureFlag {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  enabledFor      FeatureFlagScope @default(NONE)
  targetTenantIds Json             @default("[]")
  targetPlans     TenantPlan[]     @default([])
  isEnabled       Boolean          @default(false)
  updatedById     String?
  updatedAt       DateTime         @updatedAt
  createdAt       DateTime         @default(now())

  updatedBy AdminUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("feature_flags")
}
