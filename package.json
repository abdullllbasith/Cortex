{
  "name": "saios",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:turbo": "node scripts/dev.mjs --turbo",
    "dev:clean": "node scripts/clean-dev-cache.mjs",
    "dev:fresh": "node scripts/clean-dev-cache.mjs && node scripts/dev.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:check": "node scripts/check-db.mjs",
    "db:seed": "tsx --tsconfig tsconfig.scripts.json prisma/seed.ts",
    "db:seed:user": "tsx --tsconfig tsconfig.scripts.json scripts/seed-user-demo.ts",
    "db:seed:hr": "tsx --tsconfig tsconfig.scripts.json scripts/seed-hr-only.ts",
    "db:seed:demo": "tsx --tsconfig tsconfig.scripts.json src/lib/seed/demoDataSeed.ts",
    "db:studio": "prisma studio",
    "worker:agents": "tsx src/lib/queue/agentWorker.ts",
    "worker:analytics": "tsx src/lib/queue/analyticsSnapshotWorker.ts",
    "worker:ml": "tsx src/lib/queue/mlFeatureWorker.ts",
    "worker:workflows": "tsx src/lib/queue/workflowWorker.ts",
    "worker:reorder": "tsx src/lib/queue/reorderWorker.ts",
    "worker:invoice-overdue": "tsx src/lib/queue/invoiceOverdueWorker.ts",
    "worker:follow-up": "tsx src/lib/queue/followUpWorker.ts",
    "worker:notifications": "tsx src/lib/notifications/queue/notificationWorker.ts",
    "setup:storage": "node scripts/ensure-supabase-storage.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "0.35.3"
  },
