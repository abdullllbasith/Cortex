# ── Database ─────────────────────────────────────────────────────────────────
# Runtime (app + Vercel): Supavisor transaction pooler (IPv4-safe for serverless)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations / prisma db push (Supavisor session pooler)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# ── OpenAI / OpenRouter (assistant + agents) ────────────────────────────────
OPENAI_API_KEY="sk-..."
# OpenRouter (preferred)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Cheap paid chain: GPT-4o mini → Gemini 2.5 Flash Lite
LLM_CHAT_MODELS="openai/gpt-4o-mini,google/gemini-2.5-flash-lite"
LLM_PREDICTION_MODELS="openai/gpt-4o-mini,google/gemini-2.5-flash-lite"
OPENAI_ASSISTANT_MODEL="openai/gpt-4o-mini"
OPENAI_ASSISTANT_MAX_TOKENS="2048"

# ── Anthropic (optional — no longer required; assistant uses OpenAI above) ───
# ANTHROPIC_API_KEY="sk-ant-..."

# ── Redis (optional — knowledge cache, agent queues, analytics snapshots) ─────
# Leave empty if Redis is not running locally. The app works without it.
REDIS_URL=""

# ── Upstash Redis (assistant rate limiting — optional, preferred in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-use-32-char-minimum-secret"
# Dev mode: skip JWT verification when true (local development only)
AUTH_DEV_MODE="true"

# ── Supabase (existing auth) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Password reset emails use SMTP below; add these to Supabase Auth → URL Configuration → Redirect URLs:
# http://localhost:3000/auth/confirm
# http://localhost:3000/reset-password
# (and the same paths on your production domain)
# Storage buckets (created via npm run setup:storage)
NEXT_PUBLIC_SUPABASE_UPLOAD_BUCKET="uploads"
NEXT_PUBLIC_SUPABASE_DOCUMENT_BUCKET="documents"

# ── Encryption (tenant field encryption — falls back to JWT_SECRET in dev) ────
ENCRYPTION_MASTER_KEY=""

# ── API ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="saios-verify-token"

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""

# ── Email (Gmail SMTP — preferred) or SendGrid fallback ───────────────────────
# Gmail: enable 2FA → Google Account → App Passwords → generate 16-char password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM_EMAIL="your@gmail.com"
SMTP_FROM_NAME="SAIOS"
# Optional: default recipient for ML alert email channel
# ALERT_EMAIL_TO="alerts@yourdomain.com"

# SendGrid (optional fallback if SMTP is not set)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="assistant@yourdomain.com"
SENDGRID_FROM_NAME="SAIOS"

# ── Web Push (Module 09 notifications) ───────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:notifications@saios.app"

# ── Stripe webhooks (billing notifications) ───────────────────────────────────
STRIPE_WEBHOOK_SECRET=""

# ── Platform Admin (Module 11) ────────────────────────────────────────────────
# Dedicated platform admin login (required for /admin/* access)
PLATFORM_ADMIN_EMAIL="admin@saios.local"
PLATFORM_ADMIN_PASSWORD="change-me-admin-password"
# Comma-separated IPs allowed to access /admin and /api/admin (empty = allow all)
ADMIN_IP_ALLOWLIST=""
# Comma-separated allowed hosts for agent external API calls
AGENT_ALLOWED_API_HOSTS=""
