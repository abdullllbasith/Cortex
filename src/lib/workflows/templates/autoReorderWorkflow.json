{
  "name": "Auto Reorder on Low Stock",
  "description": "Evaluates low-stock events and optionally creates draft purchase orders.",
  "triggerType": "EVENT",
  "triggerConfig": { "eventType": "stock_below_reorder" },
  "nodes": [
    {
      "id": "t1",
      "type": "trigger.event",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "Stock Below Reorder",
        "config": { "eventType": "stock_below_reorder" }
      }
    },
    {
      "id": "n1",
      "type": "action.ai_decision",
      "position": { "x": 260, "y": 0 },
      "data": {
        "label": "Should auto-create PO?",
        "config": {
          "prompt": "Should we auto-create a PO for {{productName}} with {{currentStock}} units remaining? Supplier lead time is {{leadTimeDays}} days. Reply with JSON: {\"autoApprove\": boolean, \"reason\": string}",
          "outputVariable": "n1"
        }
      }
    },
    {
      "id": "n2",
      "type": "control.condition",
      "position": { "x": 540, "y": 0 },
      "data": {
        "label": "Auto-approve?",
        "config": {
          "conditions": [{ "field": "n1.autoApprove", "operator": "eq", "value": true }],
          "logic": "AND"
        }
      }
    },
    {
      "id": "n3",
      "type": "action.create_purchase_order",
      "position": { "x": 820, "y": -40 },
      "data": {
        "label": "Create Draft PO",
        "config": {
          "supplierIdField": "supplierId",
          "suggestionsField": "reorderSuggestions",
          "respectAutoApprove": false
        }
      }
    },
    {
      "id": "n4",
      "type": "action.send_notification",
      "position": { "x": 1100, "y": 40 },
      "data": {
        "label": "Notify manager",
        "config": {
          "channel": "slack",
          "recipient": "#inventory",
          "message": "Draft PO created for {{productName}} — review in Reorder Centre."
        }
      }
    },
    {
      "id": "a0",
      "type": "action.generate_reorder_suggestion",
      "position": { "x": 260, "y": 120 },
      "data": {
        "label": "Build suggestion",
        "config": { "productIdField": "productId", "urgency": "all" }
      }
    }
  ],
  "edges": [
    { "id": "e0", "source": "t1", "target": "a0" },
    { "id": "e1", "source": "a0", "target": "n1" },
    { "id": "e2", "source": "n1", "target": "n2" },
    { "id": "e3", "source": "n2", "target": "n3", "sourceHandle": "true" },
    { "id": "e4", "source": "n3", "target": "n4" }
  ]
}
