    { "id": "e8", "source": "c-activity", "target": "a-escalate", "sourceHandle": "false" },
    { "id": "e9", "source": "c-activity", "target": "d7", "sourceHandle": "true" },
    { "id": "e10", "source": "d7", "target": "c-deal" },
    { "id": "e11", "source": "c-deal", "target": "a-offer", "sourceHandle": "false" },
    { "id": "e12", "source": "a-offer", "target": "d90" },
