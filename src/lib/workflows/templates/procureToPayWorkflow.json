{
  "triggerType": "EVENT",
  "triggerConfig": { "eventType": "stock_below_reorder" },
  "nodes": [
    {
      "id": "t1",
      "type": "trigger.event",
      "position": { "x": 0, "y": 200 },
      "data": {
        "label": "STOCK_BELOW_REORDER",
        "config": { "eventType": "stock_below_reorder" }
      }
    },
    {
      "id": "a-ai",
      "type": "action.ai_decision",
      "position": { "x": 240, "y": 200 },
      "data": {
        "label": "AI Auto-Order Decision",
        "config": {
          "prompt": "Should we auto-order {{productName}} from supplier {{supplierId}}? Current stock {{currentStock}}, reorder point {{reorderPoint}}. Respond JSON: {\"autoApprove\":boolean,\"recommendedQty\":number,\"reason\":string}",
          "outputVariable": "ai.procurement"
        }
      }
    },
    {
      "id": "c-auto",
      "type": "control.condition",
      "position": { "x": 500, "y": 200 },
      "data": {
        "label": "autoApprove = true?",
        "config": {
          "conditions": [{ "field": "aiResult.autoApprove", "operator": "eq", "value": true }],
          "logic": "AND"
        }
      }
    },
    {
      "id": "a-suggest",
      "type": "action.generate_reorder_suggestion",
      "position": { "x": 760, "y": 120 },
      "data": {
        "label": "Reorder Suggestions",
        "config": { "productIdField": "productId", "urgency": "all" }
      }
    },
    {
      "id": "a-po",
      "type": "action.create_purchase_order",
      "position": { "x": 1020, "y": 120 },
      "data": {
        "label": "Create Draft PO",
        "config": {
          "respectAutoApprove": false,
          "autoApproveThreshold": 999999,
          "sendToSupplier": false
        }
      }
    },
    {
      "id": "a-po-email",
      "type": "action.send_notification",
      "position": { "x": 1280, "y": 120 },
      "data": {
        "label": "Send PO To Supplier",
        "config": {
          "channel": "email",
          "recipient": "{{supplierEmail}}",
          "message": "Purchase order {{poNumber}} has been issued. Please confirm delivery schedule."
        }
      }
    },
    {
      "id": "a-mgr-ok",
      "type": "action.send_notification",
      "position": { "x": 1540, "y": 120 },
      "data": {
        "label": "Notify Manager (PO Sent)",
        "config": {
          "channel": "slack",
          "recipient": "#procurement",
          "message": "PO {{poNumber}} sent to supplier for low stock on {{productName}}."
        }
      }
    },
    {
      "id": "a-mgr-manual",
      "type": "action.send_notification",
      "position": { "x": 760, "y": 300 },
      "data": {
        "label": "Notify Manager (Manual PO)",
        "config": {
          "channel": "slack",
          "recipient": "#procurement",
          "message": "Low stock alert: {{productName}} ({{currentStock}} on hand, reorder {{reorderPoint}}) — manual PO needed."
        }
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "t1", "target": "a-ai" },
    { "id": "e2", "source": "a-ai", "target": "c-auto" },
    { "id": "e3", "source": "c-auto", "target": "a-suggest", "sourceHandle": "true" },
    { "id": "e4", "source": "a-suggest", "target": "a-po" },
    { "id": "e5", "source": "a-po", "target": "a-po-email", "sourceHandle": "true" },
    { "id": "e6", "source": "a-po-email", "target": "a-mgr-ok" },
    { "id": "e7", "source": "c-auto", "target": "a-mgr-manual", "sourceHandle": "false" }
  ]
}
