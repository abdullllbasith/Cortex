{
  "triggerType": "EVENT",
  "triggerConfig": { "eventType": "new_order" },
  "nodes": [
    { "id": "t1", "type": "trigger.event", "position": { "x": 0, "y": 0 }, "data": { "label": "New Order", "config": { "eventType": "new_order" } } },
    { "id": "a1", "type": "action.update_record", "position": { "x": 250, "y": 0 }, "data": { "label": "Confirm Order", "config": { "entity": "product", "entityId": "{{order.productId}}", "fields": { "inventoryLevel": "{{order.newStock}}" } } } },
    { "id": "a2", "type": "action.generate_document", "position": { "x": 500, "y": 0 }, "data": { "label": "Generate Invoice", "config": { "documentType": "invoice", "data": { "orderId": "{{order.id}}", "amount": "{{order.amount}}" } } } },
    { "id": "a3", "type": "action.send_notification", "position": { "x": 750, "y": 0 }, "data": { "label": "Notify Customer", "config": { "channel": "email", "recipient": "{{customer.email}}", "message": "Your order {{order.id}} has been confirmed." } } }
  ],
  "edges": [
    { "id": "e1", "source": "t1", "target": "a1" },
    { "id": "e2", "source": "a1", "target": "a2" },
    { "id": "e3", "source": "a2", "target": "a3" }
  ]
}
