{
  "triggerType": "SCHEDULE",
  "triggerConfig": { "cronExpression": "0 9 * * *", "timezone": "UTC" },
  "nodes": [
    { "id": "t1", "type": "trigger.schedule", "position": { "x": 0, "y": 0 }, "data": { "label": "Daily 9AM", "config": { "cronExpression": "0 9 * * *", "timezone": "UTC" } } },
    { "id": "a1", "type": "action.ai_decision", "position": { "x": 250, "y": 0 }, "data": { "label": "Find Overdue", "config": { "prompt": "List overdue invoices for tenant", "outputVariable": "overdueInvoices" } } },
    { "id": "a2", "type": "action.send_notification", "position": { "x": 500, "y": 0 }, "data": { "label": "Send Reminder", "config": { "channel": "email", "recipient": "{{invoice.customerEmail}}", "message": "Reminder: invoice {{invoice.id}} is overdue" } } },
    { "id": "c1", "type": "control.condition", "position": { "x": 750, "y": 0 }, "data": { "label": "Over 7 Days?", "config": { "conditions": [{ "field": "invoice.daysOverdue", "operator": "gte", "value": 7 }], "logic": "AND" } } },
    { "id": "a3", "type": "action.send_notification", "position": { "x": 950, "y": 0 }, "data": { "label": "Escalate", "config": { "channel": "slack", "recipient": "#finance", "message": "Escalate overdue invoice {{invoice.id}}" } } }
  ],
  "edges": [
    { "id": "e1", "source": "t1", "target": "a1" },
    { "id": "e2", "source": "a1", "target": "a2" },
    { "id": "e3", "source": "a2", "target": "c1" },
    { "id": "e4", "source": "c1", "target": "a3", "sourceHandle": "true" }
  ]
}
