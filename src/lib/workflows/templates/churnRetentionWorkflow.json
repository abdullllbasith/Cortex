{
  "triggerType": "EVENT",
  "triggerConfig": { "eventType": "new_customer" },
  "nodes": [
    { "id": "t1", "type": "trigger.event", "position": { "x": 0, "y": 0 }, "data": { "label": "Churn Risk Detected", "config": { "eventType": "new_customer" } } },
    { "id": "c1", "type": "control.condition", "position": { "x": 250, "y": 0 }, "data": { "label": "High Risk?", "config": { "conditions": [{ "field": "customer.churnProbability", "operator": "gte", "value": 0.7 }], "logic": "AND" } } },
    { "id": "a1", "type": "action.send_notification", "position": { "x": 500, "y": -50 }, "data": { "label": "Retention Offer", "config": { "channel": "email", "recipient": "{{customer.email}}", "message": "We value you {{customer.name}} — here's 15% off" } } },
    { "id": "a2", "type": "action.send_notification", "position": { "x": 500, "y": 50 }, "data": { "label": "Assign Rep", "config": { "channel": "slack", "recipient": "#sales", "message": "High churn risk: {{customer.name}}" } } }
  ],
  "edges": [
    { "id": "e1", "source": "t1", "target": "c1" },
    { "id": "e2", "source": "c1", "target": "a1", "sourceHandle": "true" },
    { "id": "e3", "source": "c1", "target": "a2", "sourceHandle": "true" }
  ]
}
