{
  "triggerType": "EVENT",
  "triggerConfig": { "eventType": "order_delivered" },
  "nodes": [
    {
      "id": "t1",
      "type": "trigger.event",
      "position": { "x": 0, "y": 240 },
      "data": {
        "label": "ORDER_DELIVERED",
        "config": { "eventType": "order_delivered" }
      }
    },
    {
      "id": "a-inventory",
      "type": "action.process_order_delivery",
      "position": { "x": 240, "y": 240 },
      "data": {
        "label": "Update Inventory (SALE)",
        "config": { "orderIdField": "orderId", "skipIfAlreadyDelivered": true }
      }
    },
    {
      "id": "a-invoice",
      "type": "action.create_invoice",
      "position": { "x": 480, "y": 240 },
      "data": {
        "label": "Create Invoice",
        "config": {
          "source": "order",
          "orderIdField": "orderId",
          "sendAfterCreate": true,
          "sendChannels": ["email", "whatsapp"]
        }
      }
    },
    {
      "id": "a-notify",
      "type": "action.send_notification",
      "position": { "x": 720, "y": 240 },
      "data": {
        "label": "Send Invoice (Email + WhatsApp)",
        "config": {
          "channel": "whatsapp",
          "recipient": "{{contactPhone}}",
          "message": "Thank you! Invoice #{{invoiceNumber}} for order #{{orderNumber}} is ready. Amount due: {{amountDue}} {{currency}}."
        }
      }
    },
    {
      "id": "d1",
      "type": "control.delay",
      "position": { "x": 960, "y": 240 },
      "data": { "label": "Wait 7 days", "config": { "duration": 7, "unit": "days" } }
    },
    {
      "id": "c-pay1",
      "type": "action.check_invoice_payment",
      "position": { "x": 1200, "y": 240 },
      "data": { "label": "Check Payment (7d)", "config": { "invoiceIdField": "invoiceId" } }
    },
    {
      "id": "a-remind1",
      "type": "action.send_notification",
      "position": { "x": 1440, "y": 160 },
      "data": {
        "label": "Send Reminder",
        "config": {
          "channel": "whatsapp",
          "recipient": "{{contactPhone}}",
          "message": "Invoice #{{invoiceNumber}} is due — amount {{amountDue}} {{currency}}. Please arrange payment at your earliest convenience."
        }
      }
    },
    {
      "id": "d2",
      "type": "control.delay",
      "position": { "x": 1680, "y": 160 },
      "data": { "label": "Wait 7 more days", "config": { "duration": 7, "unit": "days" } }
    },
    {
      "id": "c-pay2",
      "type": "action.check_invoice_payment",
      "position": { "x": 1920, "y": 160 },
      "data": { "label": "Check Payment (14d)", "config": { "invoiceIdField": "invoiceId" } }
    },
    {
      "id": "a-escalate",
      "type": "action.send_notification",
      "position": { "x": 2160, "y": 80 },
      "data": {
        "label": "Escalate To Manager",
        "config": {
          "channel": "slack",
          "recipient": "#finance",
          "message": "Escalation: Invoice #{{invoiceNumber}} for order #{{orderNumber}} remains unpaid. Amount due: {{amountDue}} {{currency}}."
        }
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "t1", "target": "a-inventory" },
    { "id": "e2", "source": "a-inventory", "target": "a-invoice" },
    { "id": "e3", "source": "a-invoice", "target": "a-notify" },
    { "id": "e4", "source": "a-notify", "target": "d1" },
    { "id": "e5", "source": "d1", "target": "c-pay1" },
    { "id": "e6", "source": "c-pay1", "target": "a-remind1", "sourceHandle": "true" },
    { "id": "e7", "source": "a-remind1", "target": "d2" },
    { "id": "e8", "source": "d2", "target": "c-pay2" },
    { "id": "e9", "source": "c-pay2", "target": "a-escalate", "sourceHandle": "true" }
  ]
}
